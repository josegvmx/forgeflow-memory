{
  "name": "forgeflow-memory",
  "version": "0.1.0",
  "description": "Persistence and RAG retrieval layer for ForgeFlow",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx tests/seed.ts",
    "deploy:seed": "tsx scripts/migrate.ts && tsx scripts/deploy-seed.ts",
    "export": "tsx scripts/export.ts",
    "explore": "tsx scripts/explore-retrieval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@hono/node-server": "^1.12.0",
    "dotenv": "^16.4.5",
    "hono": "^4.4.0",
    "pgvector": "^0.2.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
