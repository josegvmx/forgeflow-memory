{
  "name": "forgeflow-memory",
  "version": "0.1.0",
  "description": "Persistence and RAG retrieval layer for ForgeFlow",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "db:migrate": "psql $DATABASE_URL -f src/store/schema.sql",
    "seed": "tsx tests/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "dotenv": "^16.4.5",
    "hono": "^4.4.0",
    "pgvector": "^0.2.0",
    "postgres": "^3.4.4",
    "@anthropic-ai/sdk": "^0.24.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
