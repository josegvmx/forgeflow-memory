# PostgreSQL connection string
# Default matches the pgvector Docker command in README.md (Setup → Start pgvector)
DATABASE_URL=postgres://postgres:password@localhost:5432/forgeflow

# Embedding provider — pick one
VOYAGE_API_KEY=your_voyage_key_here
OPENAI_API_KEY=your_openai_key_here

# Anthropic (for synthesis step)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Admin token for write endpoints (/ingest, /events, /scenarios, /audit).
# Leave unset to disable them (recommended for public demos). Min 16 chars.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Synthesis provider: 'anthropic' (default) or 'ollama' (free, local)
SYNTHESIS_PROVIDER=anthropic

# Ollama settings (only needed if SYNTHESIS_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
